# Database
POSTGRES_USER=dashuser
POSTGRES_PASSWORD=dashpass
POSTGRES_DB=dashboard_avocado
DATABASE_URL=postgresql://dashuser:dashpass@localhost:5432/dashboard_avocado

# Server
PORT=5000
NODE_ENV=production

# JWT (REQUIRED — change this to a long random secret in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_PUBLIC=false

# App
APP_NAME=Dashboard Avocado Backend
APP_VERSION=2.1.0

# Object storage — SeaweedFS (S3-compatible). Under docker compose the API
# reaches it at http://seaweedfs:8333 automatically; these values are for
# running the API on the host (npm run dev) against the compose SeaweedFS.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=seaweedadmin
S3_SECRET_KEY=change-me-seaweed-secret
S3_BUCKET=avocado-dashboard

# Public base URL of THIS API as browsers see it. Uploaded images are served
# from <PUBLIC_API_URL>/api/files/public/... (storage itself is never public).
PUBLIC_API_URL=http://localhost:5000

# Harvest lots: minimum dry-matter % for export-grade (Hass) maturity check
DRY_MATTER_MIN_PCT=23

# Host ports (change if something else already uses them)
API_HOST_PORT=5000
POSTGRES_HOST_PORT=5432
S3_HOST_PORT=8333

# Resend (transactional email)
RESEND_API_KEY=
FROM_EMAIL=noreply@avocadodashboard.com

# Africa's Talking (SMS) — leave blank until you have credentials; SMS sends
# are silently skipped (logged, not fatal) while unconfigured, same as email
# behaves without RESEND_API_KEY.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Public web address of the dashboard. Used in password-reset emails and in the
# activation SMS sent to imported farmers (${FRONTEND_URL}/activate) — set it to
# the real public URL in production.
FRONTEND_URL=http://localhost:3000

# Rwanda land registry (NLA / LAIS) connector — leave blank until NLA grants
# API access. While blank, UPIs are validated locally and parcels are drawn
# on the map. See src/services/landRegistry.ts for the expected contract.
LAND_REGISTRY_API_URL=
LAND_REGISTRY_API_KEY=

# Seed demo accounts (admin123456 etc.) on start — true for local testing only.
SEED_DEMO_DATA=true
# Number of reverse proxies in front of the API (Coolify/Traefik = 1, none = 0)
TRUST_PROXY=0
# Max login/register/reset/activation attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Several frontend origins can be listed comma-separated in CORS_ORIGIN
# Show SMS activation codes on screen when no SMS provider is set (local testing ONLY, never production)
ALLOW_TEST_OTP=false
